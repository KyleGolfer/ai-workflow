# Venice API (from https://venice.ai/account)
VENICE_API_KEY=your_venice_key_here

# LiteLLM internal key (generate: openssl rand -hex 32)
LITELLM_MASTER_KEY=sk-litellm-your-generated-key-here

# n8n credentials
N8N_USER=admin
N8N_PASSWORD=your_secure_password_here

# Ollama
OLLAMA_HOST=ollama:11434

# Tailscale domain (we'll fill this in later)
TAILSCALE_DOMAIN=your-server.tailnet.ts.net
